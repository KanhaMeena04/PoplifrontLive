{
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/reel/:id",
      "destination": "/api/reel?id=:id"
    },
    {
      "source": "/join/:code",
      "destination": "https://popli-48dcc.web.app/join/:code"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}